{
  "manifest_version": 3,
  "name": "朝暮",
  "version": "0.1.0",
  "description": "每日壁纸 + 时钟 + 天气 + 搜索的极简新标签页。打开就是一天开始的地方。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "favicon"],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "http://*/*",
    "https://*/*"
  ]
}
